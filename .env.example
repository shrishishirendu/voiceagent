# ─── Vapi ────────────────────────────────────────────────────────────
# Your PRIVATE key from Vapi dashboard → API Keys
VAPI_PRIVATE_KEY=your-vapi-private-key-here

# ─── Twilio ──────────────────────────────────────────────────────────
# From Twilio Console homepage
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token-here

# Your Twilio phone number, in E.164 format (with + and country code)
TWILIO_PHONE_NUMBER=+18152835864

# ─── LLM ─────────────────────────────────────────────────────────────
# Anthropic API key for Claude (Vapi uses this for the call AI brain)
# Get one at console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Google Gemini API key (used for invoice PDF parsing)
# Get one at aistudio.google.com → API Keys
GEMINI_API_KEY=your-gemini-api-key-here

# ─── Public URL ──────────────────────────────────────────────────────
# Local dev: your ngrok URL (e.g. https://abc123.ngrok-free.app)
# Production: your Vercel URL (e.g. https://envoy.vercel.app)
# This is where Vapi sends webhooks when calls end.
PUBLIC_URL=https://your-ngrok-url-here.ngrok-free.app

# ─── Concurrency ─────────────────────────────────────────────────────
# Max simultaneous outbound calls. Defaults to 1 (safe for Twilio trial).
# Raise to match your Twilio account's concurrent outbound call limit.
MAX_CONCURRENT_CALLS=1

# ─── Google Drive ────────────────────────────────────────────────────
# Service account JSON key (single line, with literal \n in private_key field).
# Share your Drive folder with the service account's client_email.
# Generate at console.cloud.google.com → IAM & Admin → Service Accounts.
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"your-sa@project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# The Drive folder ID containing invoice PDFs + "Business Contact Details.xlsx"
# From the folder URL: https://drive.google.com/drive/folders/<FOLDER_ID>
GOOGLE_DRIVE_FOLDER_ID=1J6Qyi_MkBS5fQJ4qyvI58QLxSMXT5ttZ

# Optional: override the Google Sheet name (default: "Business Contact Details")
# Must be a native Google Sheet (not xlsx) in the same Drive folder.
# GOOGLE_DRIVE_CONTACTS_SHEET_NAME=Business Contact Details

# ─── Database ────────────────────────────────────────────────────────
# Supabase PostgreSQL (schema.prisma provider = postgresql).
#   DATABASE_URL → pooled connection (pgbouncer, port 6543) used at runtime.
#   DIRECT_URL   → direct connection (port 5432) used by `prisma db push` / DDL.
# Get both from Supabase → Project Settings → Database → Connection string.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require"
