generator client {
  provider = "prisma-client-js"
}

// Supabase (PostgreSQL). Prisma owns this schema — `prisma db push` reconciles it.
// url        → pooled connection (pgbouncer, port 6543) used at runtime.
// directUrl  → direct connection (port 5432) used for db push / DDL.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── CRM reference tables ──────────────────────────────────────────────

model SalesPerson {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @map("owner_id") // tenant = lowercased email
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  customers Customer[]

  @@index([ownerId])
  @@map("sales_person")
}

model Location {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @map("owner_id") // tenant = lowercased email
  code      String
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  customers Customer[]

  @@unique([ownerId, code])
  @@index([ownerId])
  @@map("location")
}

// The debtor. Replaces demo3.0's denormalized contactBusiness/abn/groupKey identity.
// The app writes businessName/abn/contactPerson/contactPhone; the remaining CRM
// columns are kept for schema fidelity but left null/default in this phase.
model Customer {
  id                    String   @id @default(uuid()) @db.Uuid
  ownerId               String   @map("owner_id") // tenant = lowercased email
  accountCode           String?  @map("account_code")
  businessName          String   @map("business_name")
  addressLine           String?  @map("address_line")
  city                  String?
  state                 String?
  postCode              String?  @map("post_code")
  contactPerson         String?  @map("contact_person")
  contactPhone          String?  @map("contact_phone")
  email1                String?  @map("email_1")
  email2                String?  @map("email_2")
  abn                   String?
  paymentTermsDays      Int?     @map("payment_terms_days")
  deliveryInstructions  String?  @map("delivery_instructions")
  creditLimit           Float?   @map("credit_limit")
  ignoreMinPrice        Boolean  @default(false) @map("ignore_min_price")
  ignoreProductMinPrice Boolean  @default(false) @map("ignore_product_min_price")
  hideInvoice           Boolean  @default(false) @map("hide_invoice")
  isActive              Boolean  @default(true) @map("is_active")
  balanceAmount         Float    @default(0) @map("balance_amount")
  salesPersonId         String?  @map("sales_person_id") @db.Uuid
  locationId            String?  @map("location_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz

  salesPerson SalesPerson? @relation(fields: [salesPersonId], references: [id])
  location    Location?    @relation(fields: [locationId], references: [id])
  invoices    Invoice[]
  calls       Call[]
  notes       Note[]
  tickets     Ticket[]

  @@index([ownerId])
  @@map("customer")
}

// One row per parsed invoice / debt. Also serves as the dispatch queue — the
// scheduler groups pending rows by debtor and dispatches one Call per debtor.
// ERD invoice columns + operational scheduling columns (chaseAfter/status/attempts/
// group_key + caller config), so the queue/scheduler can run. Money is stored as
// double precision (Float) to preserve the app's numeric semantics; dates are text
// (YYYY-MM-DD) to preserve the app's string-based date comparisons.
model Invoice {
  id                String  @id @default(uuid()) @db.Uuid
  ownerId           String  @map("owner_id") // tenant = lowercased email
  customerId        String? @map("customer_id") @db.Uuid

  // Debtor identity snapshot (used for fuzzy grouping + dialing)
  contactBusiness   String  @map("contact_business")
  contactPerson     String? @map("contact_person")
  toNumber          String? @map("to_number")
  abn               String?
  groupKey          String  @map("group_key")

  // Caller / call config carried from ingestion
  userName          String  @default("the caller") @map("user_name")
  voice             String  @default("iris")
  manner            String  @default("warm")
  objective         String

  // Invoice fields (ERD columns; amountDue → balance_amount)
  invoiceNumber     String? @map("invoice_no")
  invoiceDate       String? @map("invoice_date")
  dueDate           String? @map("due_date")
  amountDue         Float?  @map("balance_amount")
  totalAmount       Float?  @map("total_amount")
  paidAmount        Float?  @default(0) @map("paid_amount")
  currency          String? @default("AUD")
  invoiceNotes      String? @map("invoice_notes")
  bankName          String? @map("bank_name")
  bsb               String?
  accountNumber     String? @map("account_number")
  swiftCode         String? @map("swift_code")
  remittanceName    String? @map("remittance_name")
  remittanceContact String? @map("remittance_contact")

  // Source PDF in Supabase Storage (invoices bucket), if ingested from a file
  sourceFilePath    String?  @map("source_file_path")

  // Scheduling / lifecycle
  chaseAfter        DateTime @map("chase_after") @db.Timestamptz
  status            String   @default("pending") // stored | pending | queued | calling | resolved | failed | cancelled
  attempts          Int      @default(0)

  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  customer  Customer?         @relation(fields: [customerId], references: [id])
  lineItems InvoiceLineItem[]
  payments  Payment[]
  callLinks CallInvoice[]

  @@index([ownerId, status, chaseAfter])
  @@index([groupKey])
  @@map("invoice")
}

model InvoiceLineItem {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @map("invoice_id") @db.Uuid
  description String?
  quantity    Float?
  unitPrice   Float?   @map("unit_price")
  lineTotal   Float?   @map("line_total")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_line_item")
}

model Payment {
  id           String   @id @default(uuid()) @db.Uuid
  ownerId      String   @map("owner_id") // tenant = lowercased email
  invoiceId    String   @map("invoice_id") @db.Uuid
  payAmount    Float    @default(0) @map("pay_amount")
  creditAmount Float    @default(0) @map("credit_amount")
  payDate      String?  @map("pay_date")
  paymentType  String?  @map("payment_type")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([invoiceId])
  @@map("payment")
}

model Note {
  id         String   @id @default(uuid()) @db.Uuid
  ownerId    String   @map("owner_id") // tenant = lowercased email
  customerId String   @map("customer_id") @db.Uuid
  noteType   String?  @map("note_type")
  noteText   String?  @map("note_text")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([customerId])
  @@map("note")
}

// One outbound call (may aggregate multiple invoices via CallInvoice). Keeps a
// snapshot of the lead invoice (amountDue/currency/banking/remittance) for the
// detail view + SMS follow-up, consistent with the ERD's contact_* snapshot cols.
model Call {
  id                String  @id @default(uuid()) @db.Uuid
  ownerId           String  @map("owner_id") // tenant = lowercased email
  customerId        String? @map("customer_id") @db.Uuid

  contactBusiness   String  @map("contact_business")
  contactPerson     String? @map("contact_person")
  toNumber          String  @map("to_number")
  objective         String
  voice             String  @default("iris")
  manner            String  @default("warm")
  userName          String  @default("the caller") @map("user_name")

  // Lead-invoice snapshot (denormalized, for Detail view / SMS)
  invoiceNumber     String? @map("invoice_number")
  invoiceDate       String? @map("invoice_date")
  dueDate           String? @map("due_date")
  amountDue         Float?  @map("amount_due")
  currency          String?
  invoiceNotes      String? @map("invoice_notes")
  bankName          String? @map("bank_name")
  bsb               String?
  accountNumber     String? @map("account_number")
  swiftCode         String? @map("swift_code")
  abn               String?
  remittanceName    String? @map("remittance_name")
  remittanceContact String? @map("remittance_contact")

  // Vapi state
  vapiCallId        String? @unique @map("vapi_call_id")
  status            String  @default("dispatching") // dispatching | ringing | in-progress | completed | failed
  outcome           String? // success | partial | failed | no-answer

  // Results (filled after the call ends)
  durationSec       Int?    @map("duration_sec")
  endedReason       String? @map("ended_reason")
  result            String?
  summary           String?
  transcript        Json?   @db.JsonB
  voicemailScript   String? @map("voicemail_script")
  recordingUrl      String? @map("recording_url")

  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  customer     Customer?     @relation(fields: [customerId], references: [id])
  invoiceLinks CallInvoice[]
  tickets      Ticket[]

  @@index([ownerId, status])
  @@map("call")
}

// One outbound ticket per Call (EnvoyIn-shaped: mirrors envoyin's `tickets` table so a
// later merge is a schema union, not a translation). Unlike EnvoyIn's tickets — which
// only have a free-text `requester` — this carries a real `customerId` FK to the CRM
// Customer (requirement B) and a `callId` link to the outbound Call it represents.
model Ticket {
  id         String   @id @default(uuid()) @db.Uuid
  ownerId    String   @map("owner_id") // tenant = lowercased email
  customerId String?  @map("customer_id") @db.Uuid
  callId     String?  @map("call_id") @db.Uuid
  title      String?
  requester  String? // free-text (matches EnvoyIn); business name for outbound
  channel    String   @default("phone")
  status     String   @default("Incoming") // Incoming | In Progress | Resolved
  triage     Json?    @db.JsonB
  aiSummary  String?  @map("ai_summary")
  body       String?
  transcript Json?    @db.JsonB
  tags       Json     @default("[]") @db.JsonB // includes "outbound" / "inbound"
  messages   Json     @default("[]") @db.JsonB
  notes      Json     @default("[]") @db.JsonB
  payment    Json     @default("{}") @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  customer Customer? @relation(fields: [customerId], references: [id])
  call     Call?     @relation(fields: [callId], references: [id])

  @@index([ownerId, status])
  @@index([customerId])
  @@index([callId])
  @@map("ticket")
}

// Join table: which invoices a call discusses/chases (replaces Invoice.callId).
model CallInvoice {
  id        String   @id @default(uuid()) @db.Uuid
  callId    String   @map("call_id") @db.Uuid
  invoiceId String   @map("invoice_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  call    Call    @relation(fields: [callId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([callId, invoiceId])
  @@index([callId])
  @@index([invoiceId])
  @@map("call_invoice")
}

// Per-tenant runtime config (one row per owner). Was a global singleton
// (id = "singleton") before multi-tenancy — now keyed by ownerId. Holds the
// scheduler's business-hours/timezone/retry config. `getSettings(ownerId)` upserts it.
model Settings {
  ownerId         String  @id @map("owner_id") // tenant = lowercased email
  bhStartHour     Int     @default(9) @map("bh_start_hour")
  bhEndHour       Int     @default(17) @map("bh_end_hour")
  bhDays          String  @default("1,2,3,4,5") @map("bh_days")
  timezone        String  @default("Australia/Sydney")
  dueOffsetDays   Int     @default(0) @map("due_offset_days")
  sortField       String  @default("overdue") @map("sort_field")
  sortDir         String  @default("asc") @map("sort_dir")
  schedulerOn     Boolean @default(true) @map("scheduler_on")
  smsEnabled      Boolean @default(false) @map("sms_enabled")
  retryDelayHours Int     @default(24) @map("retry_delay_hours")
  autoRetry       Boolean @default(true) @map("auto_retry")

  @@map("settings")
}

// ─── Tenancy & auth ────────────────────────────────────────────────────

// Per-tenant profile/config blob — the analogue of EnvoyIn's `app_config` row.
// Holds everything that has no natural relational home: business identity +
// onboarding state + call-moment rules + delivery address (`data`), the tenant's
// outbound caller-id (`phoneNumber`, one number per business), the member list
// (`members`), forecasting history, and (Phase 3) per-tenant outbound credentials.
// New-owner detection = "does a Tenant row exist for this ownerId" (page-level check).
model Tenant {
  ownerId         String   @id @map("owner_id") // lowercased email
  businessName    String?  @map("business_name")
  phoneNumber     String?  @unique @map("phone_number") // per-business outbound caller-id
  data            Json     @default("{}") @db.JsonB
  members         Json     @default("[]") @db.JsonB
  forecastHistory Json     @default("[]") @db.JsonB @map("forecast_history")
  credentials     Json?    @db.JsonB
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("tenant")
}

// NextAuth adapter tables (JWT strategy — no Session table). `User.id` is the
// lowercased email, forced by the Prisma auth adapter, so it doubles as `ownerId`
// everywhere — matching EnvoyIn's "owner_id = lowercased email" identity model.
model User {
  id            String    @id // = lowercased email
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime? @map("email_verified") @db.Timestamptz

  accounts Account[]

  @@map("users")
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime @db.Timestamptz

  @@unique([identifier, token])
  @@map("verification_tokens")
}
