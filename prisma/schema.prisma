generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"    
  url      = env("DATABASE_URL")
}

model Call {
  id              String   @id @default(cuid())

  // Brief (set by user before dispatch)
  contactBusiness String
  contactPerson   String?
  toNumber        String
  objective       String
  voice           String   @default("marcus")
  manner          String   @default("warm")
  invoiceNumber   String?
  invoiceDate     String?
  dueDate         String?
  amountDue       Float?
  currency        String?
  lineItems       String?  // JSON string
  invoiceNotes    String?
  bankName        String?
  bsb             String?
  accountNumber   String?
  swiftCode       String?
  abn             String?
  remittanceName  String?
  remittanceContact String?

  // Vapi state
  vapiCallId      String?  @unique
  status          String   @default("dispatching") // dispatching | ringing | in-progress | completed | failed
  outcome         String?  // success | partial | failed | no-answer

  // Results (filled after call ends)
  durationSec     Int?
  endedReason     String?
  result          String?
  summary         String?
  transcript      String?  // JSON string of [{who, text}]
  voicemailScript String?
  recordingUrl    String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
